<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Secuencia de folio para valoraciones.
            Formato: VAL/2026/00001
            Padding 5, implementación estándar (folios cancelados quedan
            "quemados" porque el registro permanece en BD aunque cambie de
            estado: nunca se reutiliza el número).
            company_id=False => secuencia global (preparada para multi-compañía
            futura: cuando se requiera, clonar y asignar company_id).
        -->
        <record id="seq_valoracion_valoracion" model="ir.sequence">
            <field name="name">Folio Valoración VitalHealth</field>
            <field name="code">valoracion.valoracion</field>
            <field name="prefix">VAL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
