<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Acción de reporte para valoración.
        XMLID: valoracion.action_report_valoracion
        Esta XMLID es la que valoracion_valoracion.action_descargar_pdf
        referencia con env.ref(...) para disparar el reporte.

        binding_model_id + binding_type='report' añaden la opción
        "Imprimir → Valoración Funcional VitalHealth" en el menú del registro.

        print_report_name define el nombre sugerido del archivo PDF al
        descargar, sustituyendo '/' del folio por '_' para que el sistema
        operativo lo acepte como nombre de archivo.
    -->
    <record id="action_report_valoracion" model="ir.actions.report">
        <field name="name">Valoración Funcional VitalHealth</field>
        <field name="model">valoracion.valoracion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">valoracion.report_valoracion_template</field>
        <field name="report_file">valoracion.report_valoracion_template</field>
        <field name="print_report_name">'Valoracion_%s_%s' % ((object.name or 'sin_folio').replace('/', '_'), (object.partner_id.name or 'cliente').replace('/', '_').replace(' ', '_'))</field>
        <field name="binding_model_id" ref="model_valoracion_valoracion"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
