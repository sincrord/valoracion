<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Fase 4.4 — PDF Premium Wellness.

        Diseño:
          * Paleta: morado marca #714B67, crema #FAF7F2, dorado suave #A77E5C.
          * Portada con jerarquía clara (cliente + fecha + folio).
          * Cards para prioridades y productos con borde sutil + padding generoso.
          * Timeline visual para programas funcionales (si la IA los emitió).
          * Footer elegante con disclaimer legal discreto.
          * Compatibilidad wkhtmltopdf: solo `display: table`, márgenes,
            padding, border-radius básico. Sin grid/flex.

        IMPORTANTE:
          * Template SEPARADO del legacy. Default sigue siendo legacy.
          * Activación con setting valoracion.pdf_template=premium.
          * Snapshot del consentimiento se renderiza desde
            `consentimiento_texto_safe` (computed que arregla typos legacy
            como 'carácterfuncional').
    -->
    <template id="report_valoracion_premium_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!--
                    Fase 4.4.4 — usamos web.basic_layout en vez de
                    web.external_layout para eliminar el header y
                    footer corporativos (nombre de empresa, dirección,
                    ciudad, país). Sólo conservamos el logo centrado
                    como header propio y un footer wellness minimalista.
                -->
                <t t-call="web.basic_layout">
                    <!--
                        Fase 4.4.1 — control de saltos de página.
                        Reglas compatibles con wkhtmltopdf 0.12.6.1
                        (page-break-* legacy) + break-inside moderno
                        como fallback para nuevos engines.
                          .avoid-break       : ningún corte interno.
                          .section-block     : bloque narrativo cohesivo;
                                               evita cortar y permite
                                               salto antes si no entra.
                          .product-card      : card de producto; jamás
                                               se parte y no fuerza salto.
                          .signature-block   : consentimiento del cliente;
                                               se mueve completo si no
                                               cabe en la página actual.
                    -->
                    <style>
                        .avoid-break {
                            page-break-inside: avoid;
                            break-inside: avoid;
                        }
                        .section-block {
                            page-break-inside: avoid;
                            break-inside: avoid;
                            page-break-before: auto;
                        }
                        .product-card {
                            page-break-inside: avoid;
                            break-inside: avoid;
                            page-break-after: auto;
                        }
                        .signature-block {
                            page-break-inside: avoid;
                            break-inside: avoid;
                            page-break-before: auto;
                        }
                        h2, h3, h4 {
                            page-break-after: avoid;
                            break-after: avoid-page;
                        }
                        /*
                            Microfix 4.4.5: contenedor del logo del
                            header premium. Compensa el whitespace
                            transparente del PNG (el archivo puede traer
                            padding interno) recortando con margin
                            negativo controlado, y centra horizontalmente
                            sin deformar. Compatible con wkhtmltopdf
                            0.12.6.1 — sin flex/grid.
                        */
                        .premium-logo-wrap {
                            text-align: center;
                            margin: 0 auto;
                            padding: 0;
                            line-height: 0;
                        }
                        .premium-logo-wrap img {
                            display: inline-block;
                            max-height: 160px;
                            height: auto;
                            width: auto;
                            max-width: 70%;
                            vertical-align: middle;
                            margin: 0 auto;
                        }
                    </style>
                    <div class="page"
                         style="font-family: 'Helvetica', 'Arial', sans-serif;
                                color: #2C2A29; line-height: 1.55;">

                        <!-- ==============================================
                             HEADER — logo solo, centrado, minimalista.
                             Sin nombre/dirección/ciudad/país (4.4.4).
                             Microfix 4.4.5: contenedor .premium-logo-wrap
                             para tamaño nítido y proporcional. El padding
                             se reparte equilibrado para que el logo NO
                             quede desfasado hacia arriba, contemplando
                             que el PNG puede traer whitespace transparente
                             interno (no asumimos que sea del archivo).
                             ============================================== -->
                        <div class="avoid-break premium-logo-wrap"
                             style="padding: 4px 0 4px 0;">
                            <img t-if="doc.company_id.logo"
                                 t-att-src="'data:image/png;base64,%s' % doc.company_id.logo.decode('ascii') if doc.company_id.logo else False"
                                 alt="Logo"/>
                        </div>

                        <!-- ==============================================
                             PORTADA — equilibrio visual 4.4.3 restaurado.
                             Cliente prominente + folio/fecha estructurados
                             (en lugar de la versión minimalista vacía
                             de 4.4.4).
                             ============================================== -->
                        <div class="avoid-break"
                             style="padding: 16px 0 22px 0;
                                    border-bottom: 1px solid #E8E2D8;
                                    margin-bottom: 26px;">
                            <p style="font-size: 10px; letter-spacing: 2.5px;
                                      color: #A77E5C; text-transform: uppercase;
                                      margin: 0 0 10px 0; font-weight: 500;">
                                Valoración funcional · VitalHealth
                            </p>
                            <h1 style="font-size: 30px; color: #714B67;
                                       margin: 0 0 8px 0; font-weight: 600;
                                       letter-spacing: -0.6px;
                                       line-height: 1.15;">
                                Tu acompañamiento integral
                            </h1>
                            <p style="font-size: 22px; color: #2C2A29;
                                      margin: 0 0 18px 0; font-weight: 500;
                                      letter-spacing: -0.3px;
                                      line-height: 1.25;">
                                <span t-field="doc.partner_id.name"/>
                            </p>
                            <table style="width: 100%; border: none;
                                          border-collapse: collapse;
                                          margin-top: 4px;">
                                <tr>
                                    <td style="border: none; padding: 0;
                                               vertical-align: top;
                                               font-size: 10px; color: #A77E5C;
                                               letter-spacing: 1.5px;
                                               text-transform: uppercase;">
                                        Folio
                                        <span style="display: block;
                                                     margin-top: 4px;
                                                     font-size: 12px;
                                                     color: #2C2A29;
                                                     letter-spacing: 0;
                                                     text-transform: none;
                                                     font-weight: 600;">
                                            <span t-field="doc.name"/>
                                        </span>
                                    </td>
                                    <td style="border: none; padding: 0;
                                               vertical-align: top;
                                               text-align: right;
                                               font-size: 10px; color: #A77E5C;
                                               letter-spacing: 1.5px;
                                               text-transform: uppercase;">
                                        Fecha
                                        <span style="display: block;
                                                     margin-top: 4px;
                                                     font-size: 12px;
                                                     color: #2C2A29;
                                                     letter-spacing: 0;
                                                     text-transform: none;
                                                     font-weight: 500;">
                                            <t t-if="doc.date">
                                                <span t-field="doc.date"
                                                      t-options='{"format": "dd MMMM yyyy"}'/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="doc.create_date"
                                                      t-options='{"format": "dd MMMM yyyy"}'/>
                                            </t>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ==============================================
                             1. RESUMEN ESTRATÉGICO (si existe)
                             ============================================== -->
                        <t t-if="doc.resumen_estrategico">
                            <div class="section-block avoid-break"
                                 style="background-color: #FAF7F2;
                                        padding: 20px 22px; border-radius: 6px;
                                        margin-bottom: 28px;
                                        border-left: 3px solid #714B67;">
                                <p style="font-size: 10px; letter-spacing: 1.5px;
                                          color: #A77E5C; text-transform: uppercase;
                                          margin: 0 0 8px 0;">
                                    En esencia
                                </p>
                                <div style="font-size: 12px; color: #2C2A29;"
                                     t-field="doc.resumen_estrategico"/>
                            </div>
                        </t>

                        <!-- ==============================================
                             2. LO QUE CUENTA TU ESTUDIO
                             (analisis + resultados_valoracion narrativos)
                             ============================================== -->
                        <t t-if="doc.resultados_valoracion">
                            <h2 style="font-size: 17px; color: #714B67;
                                       margin: 22px 0 10px 0; font-weight: 600;
                                       letter-spacing: -0.2px;">
                                Lo que cuenta tu estudio
                            </h2>
                            <div style="font-size: 12px; color: #2C2A29;
                                        margin-bottom: 24px;"
                                 t-field="doc.resultados_valoracion"/>
                        </t>

                        <!-- ==============================================
                             3. ÁREAS PRIORITARIAS (cards)
                             ============================================== -->
                        <t t-if="doc.prioridades_caso">
                            <h2 style="font-size: 17px; color: #714B67;
                                       margin: 22px 0 12px 0; font-weight: 600;
                                       letter-spacing: -0.2px;">
                                Áreas prioritarias para tu acompañamiento
                            </h2>
                            <div style="border: 1px solid #E8E2D8;
                                        border-radius: 6px; padding: 20px 22px;
                                        background-color: #FFFFFF;
                                        font-size: 12px; color: #2C2A29;
                                        margin-bottom: 24px;"
                                 t-field="doc.prioridades_caso"/>
                        </t>

                        <!-- ==============================================
                             4. PLAN FUNCIONAL (prosa)
                             ============================================== -->
                        <t t-if="doc.plan_estrategico">
                            <h2 style="font-size: 17px; color: #714B67;
                                       margin: 22px 0 10px 0; font-weight: 600;
                                       letter-spacing: -0.2px;">
                                Tu plan funcional
                            </h2>
                            <div style="font-size: 12px; color: #2C2A29;
                                        margin-bottom: 20px;"
                                 t-field="doc.plan_estrategico"/>
                        </t>

                        <!-- ==============================================
                             5. PRODUCTOS RECOMENDADOS (cards apiladas)
                             ============================================== -->
                        <t t-if="doc.linea_producto_ids">
                            <h2 style="font-size: 17px; color: #714B67;
                                       margin: 22px 0 6px 0; font-weight: 600;
                                       letter-spacing: -0.2px;">
                                Productos VitalHealth para acompañarte
                            </h2>
                            <p style="font-size: 10px; color: #A77E5C;
                                      font-style: italic; margin: 0 0 14px 0;">
                                Estimación mensual (30 días)
                            </p>
                            <t t-foreach="doc.linea_producto_ids" t-as="linea">
                                <div class="product-card avoid-break"
                                     style="border: 1px solid #E8E2D8;
                                            border-radius: 8px;
                                            padding: 16px 20px 14px 20px;
                                            margin-bottom: 12px;
                                            background-color: #FFFFFF;">
                                    <!-- Header: badge + nombre del producto -->
                                    <table style="width: 100%; border: none;
                                                  border-collapse: collapse;
                                                  margin-bottom: 6px;">
                                        <tr>
                                            <td style="border: none; padding: 0;
                                                       vertical-align: middle;
                                                       width: 34px;">
                                                <div style="background-color: #714B67;
                                                            color: #FFFFFF;
                                                            width: 24px; height: 24px;
                                                            border-radius: 50%;
                                                            text-align: center;
                                                            font-size: 10px;
                                                            line-height: 24px;
                                                            font-weight: 600;
                                                            letter-spacing: 0.3px;">
                                                    <span t-esc="linea_index + 1"/>
                                                </div>
                                            </td>
                                            <td style="border: none; padding: 0;
                                                       vertical-align: middle;">
                                                <t t-if="linea.product_id">
                                                    <p style="margin: 0;
                                                              font-size: 13px;
                                                              color: #2C2A29;
                                                              font-weight: 600;
                                                              letter-spacing: -0.1px;">
                                                        <span t-field="linea.product_id.display_name"/>
                                                    </p>
                                                </t>
                                                <t t-else="">
                                                    <p style="margin: 0;
                                                              font-size: 12px;
                                                              color: #B5613A;
                                                              font-style: italic;">
                                                        <span t-esc="linea.product_name_ia or '(sin nombre)'"/>
                                                        — no encontrado en catálogo
                                                    </p>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>

                                    <!-- Dosis sugerida (subtítulo discreto) -->
                                    <p t-if="linea.dosis_sugerida"
                                       style="margin: 0 0 0 34px;
                                              font-size: 10px;
                                              color: #A77E5C;
                                              font-style: italic;
                                              letter-spacing: 0.1px;">
                                        <span t-esc="linea.dosis_sugerida"/>
                                    </p>

                                    <!-- Razón funcional (prosa) -->
                                    <p t-if="linea.razon"
                                       style="margin: 8px 0 10px 34px;
                                              font-size: 11px;
                                              color: #2C2A29;
                                              line-height: 1.55;">
                                        <span t-esc="linea.razon"/>
                                    </p>

                                    <!-- Footer card: cantidad + subtotal,
                                         peso visual más bajo. -->
                                    <div style="margin: 8px 0 0 34px;
                                                padding-top: 8px;
                                                border-top: 1px dashed #E8E2D8;
                                                font-size: 10px;
                                                color: #5C5752;
                                                letter-spacing: 0.2px;">
                                        <span>
                                            Cantidad:
                                            <span style="color: #2C2A29;
                                                         font-weight: 500;">
                                                <span t-esc="linea.cantidad"
                                                      t-options='{"widget": "float", "precision": 2}'/>
                                            </span>
                                        </span>
<!-- Se deja de mostrar en el reporte el precio
                                        <t t-if="linea.product_id">
                                            <span style="margin-left: 14px;
                                                         color: #A77E5C;">·</span>
                                            <span style="margin-left: 14px;">
                                                Subtotal:
                                                <span style="color: #714B67;
                                                             font-weight: 600;">
                                                    <span t-field="linea.subtotal"
                                                          t-options='{"widget": "monetary", "display_currency": linea.currency_id}'/>
                                                </span>
                                            </span>
                                        </t>            -->
                                    </div>
                                </div>
                            </t>

                            <!-- Total estimado mensual — peso visual sutil 
                            <div class="avoid-break"
                                 style="margin-top: 10px; padding: 12px 20px;
                                        background-color: #FAF7F2;
                                        border-radius: 8px;
                                        text-align: right;
                                        font-size: 11px;
                                        letter-spacing: 0.2px;">
                                <t t-set="total_estimado"
                                   t-value="sum(doc.linea_producto_ids.mapped('subtotal'))"/>
                                <t t-set="total_currency"
                                   t-value="doc.linea_producto_ids[:1].currency_id or doc.company_id.currency_id"/>
                                <span style="color: #A77E5C;
                                             text-transform: uppercase;
                                             letter-spacing: 1.5px;
                                             font-size: 9px;">
                                    Estimado mensual
                                </span>
                                <span style="color: #714B67;
                                             font-size: 15px;
                                             font-weight: 600;
                                             margin-left: 10px;">
                                    <span t-esc="total_estimado"
                                          t-options='{"widget": "monetary", "display_currency": total_currency}'/>
                                </span>
                            </div>      -->
                        </t>

                        <!-- ==============================================
                             6. PROGRAMAS FUNCIONALES (timeline)
                             Se renderizan SI la IA los emitió en
                             plan_estrategico/resultados_valoracion en
                             prosa. No tenemos un campo Odoo separado
                             para programas_funcionales aún (queda para
                             una iteración posterior). Mostramos placeholder
                             vacío que no se ve si no hay contenido.
                             ============================================== -->

                        <!-- ==============================================
                             7. HÁBITOS COMPLEMENTARIOS
                             ============================================== -->
                        <t t-if="doc.habitos_complementarios">
                            <div class="section-block">
                                <h2 style="font-size: 18px; color: #714B67;
                                           margin: 28px 0 12px 0; font-weight: 600;">
                                    Hábitos que apoyan tu plan
                                </h2>
                                <div style="font-size: 12px; color: #2C2A29;
                                            margin-bottom: 20px;
                                            padding: 16px 20px;
                                            background-color: #FAF7F2;
                                            border-radius: 6px;"
                                     t-field="doc.habitos_complementarios"/>
                            </div>
                        </t>

                        <!-- ==============================================
                             8. RESULTADOS ESPERADOS
                             ============================================== -->
                        <t t-if="doc.resultados_esperados">
                            <div class="section-block">
                                <h2 style="font-size: 18px; color: #714B67;
                                           margin: 28px 0 12px 0; font-weight: 600;">
                                    Qué puedes esperar
                                </h2>
                                <div style="font-size: 12px; color: #2C2A29;
                                            margin-bottom: 20px;"
                                     t-field="doc.resultados_esperados"/>
                            </div>
                        </t>

                        <!-- ==============================================
                             9. CONSIDERACIONES IMPORTANTES (legales)
                             ============================================== -->
                        <div class="section-block">
                            <h2 style="font-size: 15px; color: #714B67;
                                       margin: 22px 0 10px 0; font-weight: 600;
                                       letter-spacing: -0.1px;
                                       page-break-before: auto;">
                                Consideraciones importantes
                            </h2>
                            <div style="font-size: 11px; color: #2C2A29;
                                        padding: 14px 16px;
                                        background-color: #FAF7F2;
                                        border-left: 3px solid #714B67;
                                        border-radius: 2px;
                                        margin-bottom: 20px;">
                                <t t-if="doc.advertencias">
                                    <div t-field="doc.advertencias"/>
                                </t>
                                <t t-else="">
                                    <p style="margin: 0;">
                                        Esta valoración es un acompañamiento funcional
                                        y complementario; no sustituye la consulta con
                                        un profesional de la salud.
                                    </p>
                                </t>
                            </div>
                        </div>

                        <!-- ==============================================
                             10. CONSENTIMIENTO (snapshot SEGURO)
                             ============================================== -->
                        <div t-if="doc.consentimiento_cliente"
                             class="signature-block"
                             style="margin-top: 28px; padding: 18px 20px;
                                    border-top: 1px solid #E8E2D8;
                                    background-color: #FCFAF7;
                                    border-radius: 0 0 6px 6px;">
                            <p style="font-size: 9px; color: #A77E5C;
                                      letter-spacing: 1.8px;
                                      text-transform: uppercase;
                                      margin: 0 0 12px 0;
                                      font-weight: 500;">
                                Consentimiento informado
                            </p>
                            <div style="font-size: 10px; color: #5C5752;
                                        line-height: 1.7;"
                                 t-field="doc.consentimiento_texto_safe"/>
                            <p style="font-size: 9px; color: #A77E5C;
                                      font-style: italic;
                                      margin: 14px 0 0 0;">
                                Registrado el
                                <span t-field="doc.consentimiento_fecha"
                                      t-options='{"format": "dd/MM/yyyy HH:mm"}'/>.
                            </p>
                        </div>

                        <!-- ==============================================
                             FOOTER — minimalista final (Fase 4.4.4)
                             Sólo tagline wellness. Sin razón social,
                             dirección, ciudad ni país.
                             ============================================== -->
                        <div class="avoid-break"
                             style="margin-top: 38px; padding-top: 20px;
                                    text-align: center;">
                            <span style="display: inline-block;
                                         width: 32px; height: 1px;
                                         background-color: #A77E5C;
                                         opacity: 0.5;
                                         margin-bottom: 14px;">·</span>
                            <p style="margin: 0;
                                      color: #A77E5C;
                                      letter-spacing: 2.5px;
                                      text-transform: uppercase;
                                      font-size: 8px;
                                      font-weight: 500;">
                                Acompañamiento funcional · VitalHealth
                            </p>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
