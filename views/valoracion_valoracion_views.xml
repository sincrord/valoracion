<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         FORM VIEW
         ================================================================ -->
    <record id="view_valoracion_valoracion_form" model="ir.ui.view">
        <field name="name">valoracion.valoracion.form</field>
        <field name="model">valoracion.valoracion</field>
        <field name="arch" type="xml">
            <form string="Valoración">

                <!-- Header con botones de estado y statusbar -->
                <header>
                    <button name="action_generar_valoracion"
                            string="Generar Valoración"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_descargar_pdf"
                            string="Descargar PDF"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'generado'"/>
                    <button name="action_regenerar"
                            string="Re-generar"
                            type="object"
                            class="btn-secondary"
                            confirm="¿Re-generar la valoración? Los logs históricos se conservan, pero los campos generados se sobrescriben con la nueva respuesta."
                            invisible="state != 'generado'"/>
                    <button name="action_crear_cotizacion"
                            string="Crear Cotización"
                            type="object"
                            invisible="state != 'generado'"/>
                    <button name="action_cancelar"
                            string="Cancelar"
                            type="object"
                            invisible="state == 'cancelado'"/>
                    <button name="action_volver_borrador"
                            string="Volver a Borrador"
                            type="object"
                            invisible="state != 'cancelado'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="borrador,generado"/>
                </header>

                <sheet>

                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_ventas"
                                icon="fa-money">
                            <field name="venta_count"
                                   string="Ventas"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_citas"
                                icon="fa-calendar">
                            <field name="cita_count"
                                   string="Citas"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                type="object"
                                name="action_abrir_wizard_crear_cita"
                                icon="fa-calendar-plus-o"
                                invisible="not partner_id">
                            <span>Nueva cita</span>
                        </button>
                        <button class="oe_stat_button"
                                type="object"
                                name="action_view_ia_logs"
                                icon="fa-history"
                                groups="valoracion.group_valoracion_super_user">
                            <field name="ia_log_count"
                                   string="Logs IA"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <!-- Folio -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Banner: requisitos faltantes -->
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="is_ready_to_generate or state != 'borrador'">
                        <strong>⚠ Faltan requisitos para generar: </strong>
                        <field name="is_ready_message" readonly="1" nolabel="1"/>
                    </div>

                    <!-- Banner: cliente menor de edad -->
                    <div class="alert alert-info"
                         role="alert"
                         invisible="not is_partner_minor">
                        <strong>ℹ Cliente menor de edad.</strong>
                        Se incluirá una nota sobre supervisión profesional en
                        la valoración. No bloquea la generación.
                    </div>

                    <!-- Datos generales -->
                    <group>
                        <group string="General">
                            <field name="partner_id"
                                   options="{'no_quick_create': True}"
                                   readonly="state != 'borrador'"/>
                            <field name="user_id"
                                   readonly="state != 'borrador'"/>
                            <field name="date"
                                   readonly="state == 'cancelado'"/>
                            <field name="prompt_template_id"
                                   readonly="state != 'borrador'"
                                   options="{'no_create': True}"
                                   groups="valoracion.group_valoracion_super_user"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="1"/>
                        </group>
                        <group string="Consentimiento del cliente">
                            <field name="consentimiento_cliente"
                                   readonly="state == 'cancelado'"/>
                            <field name="consentimiento_fecha"
                                   invisible="not consentimiento_cliente"/>
                            <field name="consentimiento_responsable_id"
                                   invisible="not consentimiento_cliente"/>
                        </group>
                    </group>

                    <!-- Datos del cliente (related, readonly) -->
                    <group string="Información del Cliente"
                           invisible="not partner_id">
                        <group>
                            <field name="partner_birthdate"/>
                            <field name="partner_age"/>
                            <field name="partner_sexo"/>
                            <field name="partner_objetivo"/>
                        </group>
                        <group>
                            <field name="partner_estatura_cm"/>
                            <field name="partner_peso_kg"/>
                            <field name="partner_mobile"/>
                        </group>
                    </group>

                    <!-- Antecedente clínico (related, readonly) -->
                    <group string="Antecedente Clínico (editar en el contacto)"
                           invisible="not partner_id">
                        <field name="partner_medicamentos"
                               nolabel="0"
                               placeholder="Sin información — completa en el contacto."/>
                        <field name="partner_padecimientos"
                               nolabel="0"
                               placeholder="Sin información — completa en el contacto."/>
                        <field name="partner_suplementos"
                               nolabel="0"
                               placeholder="Sin información — completa en el contacto."/>
                        <field name="partner_alergias"
                               nolabel="0"
                               placeholder="Sin información — completa en el contacto."/>
                    </group>

                    <!-- Notebook -->
                    <notebook>

                        <!-- Pestaña 1: Archivos del Cliente -->
                        <page string="Archivos del Cliente" name="archivos">
                            <field name="archivo_cliente_ids"
                                   readonly="state != 'borrador'"
                                   context="{'default_valoracion_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="file_data"
                                           filename="file_name"
                                           widget="binary"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="file_type" widget="badge"/>
                                    <field name="file_size_human"/>
                                    <field name="extraction_status" widget="badge"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Total: <field name="archivo_count" readonly="1" nolabel="1"/> archivo(s) —
                                <field name="archivo_total_size_human" readonly="1" nolabel="1"/>.
                                Mínimo 1 archivo requerido. Tipos permitidos: PDF, XLS, XLSX, CSV, TXT, imágenes.
                            </div>
                        </page>

                        <!-- Pestaña 2: Resultado -->
                        <page string="Resultado de la Valoración"
                              name="resultado"
                              invisible="state == 'borrador'">
                            <separator string="Resultados de la Valoración"/>
                            <field name="resultados_valoracion" nolabel="1"/>
                            <separator string="Prioridades del Caso"/>
                            <field name="prioridades_caso" nolabel="1"/>
                            <separator string="Advertencias"/>
                            <field name="advertencias" nolabel="1"/>
                        </page>

                        <!-- Pestaña 3: Plan Estratégico -->
                        <page string="Plan Estratégico"
                              name="plan"
                              invisible="state == 'borrador'">
                            <separator string="Narrativa"/>
                            <field name="plan_estrategico" nolabel="1"/>
                            <separator string="Productos VitalHealth Recomendados"/>
                            <field name="linea_producto_ids"
                                   context="{'default_valoracion_id': id}">
                                <!--
                                    Vista tipo propuesta comercial.
                                    Columnas visibles: Producto | Dosis | Cantidad | Precio | Subtotal | Razón
                                    Campos técnicos (product_name_ia, match_status,
                                    regla_producto_id, cantidad_calculada_por_regla)
                                    quedan column_invisible="1" — siguen en modelo
                                    y se consultan al abrir la línea en form
                                    (sección Auditoría, solo Super Usuario).
                                -->
                                <list editable="bottom"
                                      string="Productos VitalHealth Recomendados">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="dosis_sugerida"
                                           string="Dosis"
                                           optional="show"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario" widget="monetary"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="razon" optional="show"/>
                                    <!-- Técnicos invisibles en list -->
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_name_ia" column_invisible="1"/>
                                    <field name="match_status" column_invisible="1"/>
                                    <field name="regla_producto_id" column_invisible="1"/>
                                    <field name="cantidad_calculada_por_regla" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Pestaña 4: Hábitos y Resumen -->
                        <page string="Hábitos y Resumen"
                              name="habitos"
                              invisible="state == 'borrador'">
                            <separator string="Hábitos Complementarios"/>
                            <field name="habitos_complementarios" nolabel="1"/>
                            <separator string="Resumen Estratégico"/>
                            <field name="resumen_estrategico" nolabel="1"/>
                            <separator string="Resultados Esperados"/>
                            <field name="resultados_esperados" nolabel="1"/>
                        </page>

                        <!-- Pestaña 5: Notas Internas -->
                        <page string="Notas Internas" name="notas">
                            <field name="notas_internas" nolabel="1"
                                   placeholder="Notas privadas del equipo. No aparecen en el PDF."/>
                        </page>

                        <!-- Pestaña 6: Consentimiento (snapshot) -->
                        <page string="Texto del Consentimiento"
                              name="consentimiento"
                              invisible="not consentimiento_cliente">
                            <field name="consentimiento_texto"
                                   readonly="1"
                                   nolabel="1"/>
                        </page>

                        <!-- Pestaña 7: Auditoría IA -->
                        <page string="Auditoría IA"
                              name="auditoria"
                              groups="valoracion.group_valoracion_super_user">
                            <field name="ia_log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="user_id"/>
                                    <field name="proveedor"/>
                                    <field name="modelo"/>
                                    <field name="estado" widget="badge"/>
                                    <field name="tokens_input"/>
                                    <field name="tokens_output"/>
                                    <field name="tokens_total" optional="hide"/>
                                    <field name="costo_estimado"/>
                                    <field name="duracion_ms"/>
                                    <field name="truncado" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <separator string="Último prompt enviado (solo Administrador)"
                                       groups="valoracion.group_valoracion_admin"/>
                            <field name="prompt_enviado"
                                   nolabel="1"
                                   readonly="1"
                                   groups="valoracion.group_valoracion_admin"/>
                            <separator string="Última respuesta IA cruda (solo Administrador)"
                                       groups="valoracion.group_valoracion_admin"/>
                            <field name="ai_raw_response"
                                   nolabel="1"
                                   readonly="1"
                                   groups="valoracion.group_valoracion_admin"/>
                            <separator string="Reporte PDF"/>
                            <field name="pdf_attachment_id"
                                   readonly="1"
                                   options="{'no_create': True, 'no_open': False}"/>
                            <field name="pdf_generated_at" readonly="1"/>
                        </page>

                    </notebook>

                </sheet>

                <!-- Chatter estándar Odoo 18 Community.
                     El tag <chatter/> renderiza followers, activities y messages
                     usando el widget oficial. No declarar los campos manualmente
                     porque en Odoo 18 eso los muestra como tablas O2M crudas. -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================
         LIST VIEW
         ================================================================ -->
    <record id="view_valoracion_valoracion_list" model="ir.ui.view">
        <field name="name">valoracion.valoracion.list</field>
        <field name="model">valoracion.valoracion</field>
        <field name="arch" type="xml">
            <list string="Valoraciones"
                  decoration-info="state == 'borrador'"
                  decoration-success="state == 'generado'"
                  decoration-muted="state == 'cancelado'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'borrador'"
                       decoration-success="state == 'generado'"
                       decoration-danger="state == 'cancelado'"/>
                <field name="is_ready_to_generate" optional="hide"/>
                <field name="archivo_count" optional="show"/>
                <field name="venta_count" optional="hide"/>
                <field name="company_id" optional="hide"
                       groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         KANBAN VIEW
         ================================================================ -->
    <record id="view_valoracion_valoracion_kanban" model="ir.ui.view">
        <field name="name">valoracion.valoracion.kanban</field>
        <field name="model">valoracion.valoracion</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state"
                    class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="is_partner_minor"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        <field name="partner_id"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="date"/> — <field name="user_id"/>
                                <span t-if="record.is_partner_minor.raw_value"
                                      class="badge text-bg-info ms-1">
                                    Menor de edad
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         SEARCH VIEW
         ================================================================ -->
    <record id="view_valoracion_valoracion_search" model="ir.ui.view">
        <field name="name">valoracion.valoracion.search</field>
        <field name="model">valoracion.valoracion</field>
        <field name="arch" type="xml">
            <search string="Buscar Valoraciones">
                <field name="name" string="Folio"/>
                <field name="partner_id"/>
                <field name="user_id"/>

                <filter string="Borrador" name="filter_borrador"
                        domain="[('state', '=', 'borrador')]"/>
                <filter string="Generado" name="filter_generado"
                        domain="[('state', '=', 'generado')]"/>
                <filter string="Cancelado" name="filter_cancelado"
                        domain="[('state', '=', 'cancelado')]"/>
                <separator/>
                <filter string="Mis valoraciones" name="filter_mias"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Hoy" name="filter_hoy"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Esta semana" name="filter_semana"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Este mes" name="filter_mes"
                        domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="groupby_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Usuario responsable" name="groupby_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Contacto" name="groupby_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Fecha" name="groupby_date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         ACTION
         ================================================================ -->
    <record id="action_valoracion_valoracion" model="ir.actions.act_window">
        <field name="name">Valoraciones</field>
        <field name="res_model">valoracion.valoracion</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_valoracion_valoracion_search"/>
        <field name="context">{'search_default_filter_mias': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera valoración funcional VitalHealth
            </p>
            <p>
                Una valoración registra los datos del cliente, archivos del
                expediente, y permite generar análisis y recomendaciones con
                apoyo de IA — sin sustituir consulta médica profesional.
            </p>
        </field>
    </record>

</odoo>
