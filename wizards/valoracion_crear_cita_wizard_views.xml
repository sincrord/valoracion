<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Form view del wizard de creación de cita.
            Diseño: dos columnas para datos de planeación + asunto y descripción
            en grupo inferior. Footer con botón primario "Crear Cita" y
            secundario "Cancelar".
        -->
        <record id="view_valoracion_crear_cita_wizard_form" model="ir.ui.view">
            <field name="name">valoracion.crear.cita.wizard.form</field>
            <field name="model">valoracion.crear.cita.wizard</field>
            <field name="arch" type="xml">
                <form string="Crear Cita">
                    <sheet>
                        <div class="oe_title">
                            <h2>
                                <field name="valoracion_id"
                                       readonly="1"
                                       options="{'no_open': False, 'no_create': True}"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Participantes">
                                <field name="partner_id" readonly="1"/>
                                <field name="user_id"
                                       options="{'no_create': True, 'no_quick_create': True}"/>
                            </group>
                            <group string="Horario">
                                <field name="start"/>
                                <field name="duration" widget="float_time"/>
                                <field name="stop" readonly="1"/>
                            </group>
                        </group>
                        <group string="Detalle">
                            <field name="name" placeholder="Asunto de la reunión"/>
                            <field name="description"
                                   placeholder="Descripción opcional de la cita"
                                   nolabel="0"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            La validación de solapamiento se ejecuta al pulsar
                            <strong>Crear Cita</strong>: si ya existe una cita
                            del mismo usuario en el rango propuesto, se
                            bloqueará la creación con un mensaje detallado.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_crear_cita"
                                string="Crear Cita"
                                type="object"
                                class="btn-primary"/>
                        <button special="cancel"
                                string="Cancelar"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!--
            Acción de ventana para abrir el wizard.
            target='new' = se abre como modal.
            Esta acción se referencia desde valoracion_valoracion.action_abrir_wizard_crear_cita
            (XMLID: valoracion.action_valoracion_crear_cita_wizard).
        -->
        <record id="action_valoracion_crear_cita_wizard" model="ir.actions.act_window">
            <field name="name">Crear Cita</field>
            <field name="res_model">valoracion.crear.cita.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_valoracion_crear_cita_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
